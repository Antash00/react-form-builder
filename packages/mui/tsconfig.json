{
    "compilerOptions": {
        "target": "ES2022",
        "lib": ["ES2022", "DOM"],
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "jsx": "react-jsx",
        "strict": true,
        "skipLibCheck": true,
        "verbatimModuleSyntax": true,
        "declaration": true,
        "sourceMap": true,
        "noEmitOnError": true,
        "rootDir": ".",
        "outDir": "./dist"
    },
    "include": ["src", "tests", "test-d", "vitest.config.ts"]
}
