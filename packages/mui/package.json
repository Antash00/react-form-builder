{
    "name": "@antash00/form-builder-mui",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "require": "./dist/index.cjs"
        }
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "build:js": "rollup -c",
        "build:types": "tsc -p tsconfig.types.json",
        "build": "rollup -c && tsc -p tsconfig.types.json",
        "typecheck": "pnpm build:types && tsc --noEmit",
        "test:types": "tsd --files test-d/form-builder.test-d.tsx",
        "test:unit": "vitest run",
        "test": "pnpm build && pnpm test:types && pnpm test:unit"
    },
    "devDependencies": {
        "@emotion/react": "^11.14.0",
        "@emotion/styled": "^11.14.1",
        "@mui/material": "^9.4.0",
        "@rollup/plugin-typescript": "^12.3.0",
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/react": "^16.3.3",
        "@testing-library/user-event": "^14.6.8",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "jsdom": "^30.1.3",
        "react": "^19.3.0",
        "react-dom": "^19.3.0",
        "react-hook-form": "^7.89.0",
        "rollup": "^4.64.1",
        "tsd": "^0.33.0",
        "tslib": "^2.8.1",
        "typescript": "~6.0.3",
        "vitest": "^5.0.5"
    },
    "peerDependencies": {
        "@emotion/react": "^11.14.0",
        "@emotion/styled": "^11.14.1",
        "@mui/material": "^9.4.0",
        "react": "^19.3.0",
        "react-dom": "^19.3.0",
        "react-hook-form": "^7.89.0"
    }
}
